# AI provider configuration
# Leave OPENAI_API_KEY empty to run in demo mode (deterministic local responses, no API calls).

# --- Option A: OpenRouter (recommended for this prototype) ---
# OpenRouter exposes an OpenAI-compatible API, so it works out of the box.
# Get a key at https://openrouter.ai/keys
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_MODEL=inclusionai/ling-3.1-flash
# Comma-separated models to try in order when the primary model is rate-limited
# or unavailable (429/5xx). First working model wins.
OPENAI_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,openai/gpt-4o-mini
# Model used for image generation (requires $1.00+ balance on OpenRouter)
OPENAI_IMAGE_MODEL=google/gemini-2.5-flash-image

# --- RAG (Retrieval-Augmented Generation) ---
# Embeddings for document Q&A. If EMBEDDING_API_KEY is empty, the chat
# provider config above is reused. Leave both empty for offline demo embeddings.
# EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# EMBEDDING_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small

# --- Option B: Official OpenAI API ---
# OPENAI_BASE_URL=
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Option C: Any other OpenAI-compatible gateway ---
# OPENAI_BASE_URL=https://your-gateway.example.com/v1
# OPENAI_API_KEY=your-gateway-key
# OPENAI_MODEL=agy/claude-sonnet-4-6

# "auto" = use the configured provider when a key is present, otherwise demo mode
# "demo" = always use the local demo provider
AI_MODE=auto
